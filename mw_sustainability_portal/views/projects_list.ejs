<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="stylesheets/contactpage.css" />

    <style>
        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            padding: 20px;
        }

        .project-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .image-container {
            width: 100%;
            max-width: 300px;
            aspect-ratio: 1 / 1; /* forces perfect square */
            overflow: hidden;
        }

        .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;     /* fills square, crops if needed */
            object-position: center;
        }

        .projbutton {
            border-radius: 5%;
            font-size: 20px;
            padding: 15px 20px;
            font-weight: bold;
            color: #FFEE98;
            background-color: rgb(74, 74, 147);
            margin: 20px;
            cursor: pointer;
        }

        .projbutton:hover {
            background-color: rgb(60, 60, 120);
        }

        .figcaption {
            font-weight: bold;
            font-size: 24px;
            color: #cafdff;
            margin-top: 10px;
        }

        h1 {
            text-align: center;
        }
    </style>

    <script src="/javascripts/getdata.js"></script>
</head>

<%- include('partials/topbar') %>

<body>
    <h1>PROJECTS</h1>

    <div class="gallery">
        <% if (records && records.length > 0) { %>
            <% records.forEach(function(project) { %>
                <div class="project-card">
                    
                    <div class="image-container">
                        <img src="<%= project.image_route %>" alt="<%= project.name %>">
                    </div>

                    <div class="figcaption">
                        <p><%= project.name %></p>
                        <p>Presented by: <%= project.team %></p>
                    </div>

                    <a href="/render_project/<%= project.id %>">
                        <button class="projbutton">View Project</button>
                    </a>

                </div>
            <% }); %>
        <% } else { %>
            <p style="text-align:center;">No projects found</p>
        <% } %>
    </div>
</body>
</html>