
<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="stylesheets/contactpage.css" />
        <style>
            .image-container img {
                width: 300px;
                height: 300px;
                overflow: hidden;
                object-fit: cover; /* Scales the image to cover the container while preserving aspect ratio */
                object-position: center; /* Centers the image within the container (default) */
            }
            .projbutton
            {
                border-radius: 5%;
                font-size: 20px;
                padding: 20px;
                font-weight: bold;
                color: #FFEE98;
                background-color: rgb(74, 74, 147);
                margin: 30px;
            }
            .bob
            {
                /* center button for each project */
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }
            .figcaption
            {
                text-align: center;
                font-weight: bold;
                padding-top: 25px;
                font-size: 20px;
                color: #cafdff;
            }
        </style>
    </head>

    <body>
        <button onclick="window.location.href='index.html'">Home</button>
        <h1>PROJECTS</h1>

        <div class="gallery">
            <table border="1" cellpadding="10" cellspacing="0">
                <tbody>
                    <% if (records && records.length > 0) { %>
                        <% records.forEach(function(project) { %>
                            <tr>
                                <td><%= project.name %></td>
                                <td><%= project.team %></td>
                                <td> <img src="<%= project.image_route %>" > </td>
                                <td><%= project.page_route %></td>
                                <td><%= project.html_generated %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5">No projects found</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </body>
</html>