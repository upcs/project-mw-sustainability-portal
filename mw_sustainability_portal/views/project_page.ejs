<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="/stylesheets/contactpage.css" />
        <style>
            figcaption
            {
                text-align: center;
                font-weight: bold;
                padding-top: 25px;
                font-size: 20px;
                color: #FFEE98;
            }
            img
            {
                max-width: 500px;
                max-height: 500px;
                border-radius: 5%;
            }
            .desc
            {
                padding: 50px;
                border: 2px;
                border-color: #cafdff;
                border-radius: 5%;
                background-color: rgb(74, 74, 147);
                width: 400px;
                min-height: 200px;
                margin-bottom: 50px;
                
            }
            p
            {
                color: #FFEE98;
                line-height: 200%; /* double spaced */
            }
            #deleteBut
            {
                width: 150px;
                height: 30px;

                font-size: 15px;
                border-radius: 15%;
                                                
                /* General styling */
                background-color: #94ebee; 
                color: #4c665f;
                border: 3px;
                cursor: pointer; /* Changes cursor to a hand on hover */
                display: flex;
                justify-content: center; /* Center content horizontally */
                align-items: center; /* Center content vertically */
                margin: auto;
                box-shadow: 0 2px 4px darkslategray;
                transition: all 0.2s ease;
  
            }
        </style>
    </head>

    <script src="/javascripts/delete.js" defer></script>

    <body>
        <%- include('partials/topbar') %> 
        <%- include('partials/managePage') %>
        <!-- I think this is uneeded <button onclick="window.location.href='../index.html'">Home</button><br><br>
        <button onclick="history.back()"> Projects </button> -->

        <h1> <%= proj_name %> </h1>
        <h2> <%= proj_team %> </h2>
         <div class="gallery">
            <table>
                <tr>
                    <td>
                        <figure class="bob">
                            <div class="image-container">
                                <img src=<%= images[0] %>>
                            </div>
                            <figcaption> [Insert Caption Here] </figcaption>
                        </figure>
                    </td>
                    <td>
                        <div class="desc">
                            <p style="text-align: left;">
                                2/25/2026
                            </p>
                            <p>
                                <%= description %>
                            </p>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <figure class="bob">
                            <div class="image-container">
                                <img src=<%= images[1] %>>
                            </div>
                            <figcaption>[Insert Caption Here]</figcaption>
                        </figure>
                    </td>
                </tr>
            </table>
         </div>
        
        <form id="del_proj" method="post" action="/delete_proj">
            <input type="hidden" id="proj_id" value= "<%= proj_id %>">
            <button id="deleteBut" type="submit"> Delete Project </button>
        </form>
    </body>

</html>