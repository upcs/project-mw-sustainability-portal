<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="stylesheets/contactpage.css" />
        <style>
            figcaption
            {
                text-align: center;
                font-weight: bold;
                padding-top: 25px;
                font-size: 20px;
                color: #FFEE98;
            }
            img
            {
                max-width: 500px;
                max-height: 500px;
                border-radius: 5%;
            }
            .desc
            {
                padding: 50px;
                border: 2px;
                border-color: #cafdff;
                border-radius: 5%;
                background-color: rgb(74, 74, 147);
                width: 400px;
                min-height: 200px;
                margin-bottom: 50px;
                
            }
            p
            {
                color: #FFEE98;
                line-height: 200%; /* double spaced */
            }
        </style>
    </head>

    <body>
        <% var desc = ""; %>
        <% var img_arr = []; %>

        <% records.forEach(function(asset) { %>
            <% if (asset.is_text === 1) { %>
                <% desc = asset.asset_route; %>
            <% } else if (asset.is_image === 1) { %>
                <% img_arr.push(asset.asset_route); %>
            <% } %>
        <% }); %>

        <% console.log("Description route: ", desc); %>
        <% console.log("Image routes: ", img_arr); %>

        <button onclick="window.location.href='index.html'">Home</button>
        <h1> <%= proj_name %> </h1>
        <h2> <%= proj_team %> </h2>
         <div class="gallery">
            <table>
                <tr>
                    <td>
                        <figure class="bob">
                            <div class="image-container">
                                <img src=<%= img_arr[0] %>>
                            </div>
                            <figcaption> [Insert Caption Here] </figcaption>
                        </figure>
                    </td>
                    <td>
                        <div class="desc">
                            <p style="text-align: left;">
                                2/25/2026
                            </p>
                            <iframe srcdoc="<p> <%= desc %> </p>" > </iframe>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <figure class="bob">
                            <div class="image-container">
                                <img src=<%= img_arr[1] %>>
                            </div>
                            <figcaption>[Insert caption here]</figcaption>
                        </figure>
                    </td>
                </tr>
            </table>
         </div>
    </body>

</html>