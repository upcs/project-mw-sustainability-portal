<!DOCTYPE html>

<html>
<head>
    <title>Projects</title>
</head>
<body>

<p>Welcome, sustainability enthusiast</p>
    <table>
        <thead>
            <tr>
                <th>Project Name</th>
                <th>Team</th>
            </tr>
        </thead>
        <tbody>
            <% var count = 1 %>
            <% records.forEach(function(results) { %>
            
            <% if count % 2 == 1 { %>
                <tr>
                    <td><%= results.name %></td>
                    <td><%= results.team %></td>
                </tr>
            <% } else { %>
                <tr>
                    <td><%= results.name %></td>
                    <td><%= results.team %></td>                
                </tr>
            <% } %>
            <% count += 1 %> 
        <% }); %>
        </tbody>
    </table>

</body>
</html>


