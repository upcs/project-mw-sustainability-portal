<!DOCTYPE html>

<script src="/javascripts/uploadProj.js" defer ></script>
<html>
  
  <body>
    <%- include('partials/topbar') %>
   <h2>New Projects Form</h2>

   <form id="projInput" method="post" action="/upload_new_proj" enctype="multipart/form-data">
      <label for="projName">Project Name: </label>
      <input type="text" id="projName" name = "name">

      <label for="projTeam">Project Team: </label>
      <input type="text" id="projTeam" name = "team">

      <label for="pageDescrip">Project Description: </label>
      <input type="text" id="pageDescrip" name = "description">

      <label for="file"> File to be uploaded: </label>
      <input type="file" name="uploadFile" id="file">

        

      <button type="submit" >Upload</button>
   </form>
  </body>
</html>
