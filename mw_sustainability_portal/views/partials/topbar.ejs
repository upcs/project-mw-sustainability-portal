      /*NavBar Styles*/
.navbar {
  overflow: hidden;
  position: sticky;
  left: 0;
  top: 0;
  cursor: pointer;
  background-color: #333;
  font-family: Arial, Helvetica, sans-serif;
}

.navbar a {
  /*border-radius: 10%; */
  float: left;
  font-size: 16px;
  color: white;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}


.login a{
  float: right;
  font-size: 16px;
  color: rgb(255, 255, 255);
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
  border-radius: 10%;
  color: #4c665f;
  background-color: #94ebee;
  
}

.dropdown {
  float: left;
  overflow: hidden;
}



  .navbar a:hover, .dropdown:hover .dropbtn, .dropbtn:focus, .button-as-link:hover {
